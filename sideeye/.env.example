# Copy to .env and fill in
# NOTE: uses a dedicated `sideeye` database, not `postgres` — the `postgres` DB in the
# local my-postgres container holds an unrelated Django app's tables.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sideeye"

# Google OAuth (the only login method in v1).
# Create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# Authorized JavaScript origin: http://localhost:3000
# LAN/phone testing: Google only redirects to URIs pre-registered above, so add
#   http://<your-LAN-IP>:3000/api/auth/callback/google (+ origin) there, then
#   REMOVE NEXTAUTH_URL below and restart — trustHost derives the callback host
#   from the request, so localhost and LAN logins both work.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Session signing secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# AUTH_SECRET is the Auth.js v5 name; NEXTAUTH_SECRET is kept as a fallback.
AUTH_SECRET=""
NEXTAUTH_SECRET=""

NEXTAUTH_URL="http://localhost:3000"

# First admin, auto-promoted on Google sign-in (spec §8). Leave empty to disable.
ADMIN_EMAIL=""

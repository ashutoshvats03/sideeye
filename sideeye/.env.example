# Copy to .env and fill in
# NOTE: uses a dedicated `sideeye` database, not `postgres` — the `postgres` DB in the
# local my-postgres container holds an unrelated Django app's tables.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sideeye"

# Google OAuth (the only login method in v1).
# Create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# Authorized JavaScript origin: http://localhost:3000
# LAN/phone testing: Google REJECTS redirect URIs on private IPs (192.168.x.x etc)
# with "Error 400: device_id and device_name are required for private IP" — a
# Google policy, not an app bug (only loopback/localhost and public hosts allowed).
# Do NOT register a LAN-IP redirect URI. Instead use one of:
#   a) USB: `adb reverse tcp:3000 tcp:3000`, then open http://localhost:3000 on
#      the phone (redirect URI stays the registered localhost one), or
#   b) Tunnel: `ngrok http 3000` (or Cloudflare quick tunnel), register the public
#      https URL + /api/auth/callback/google in the console, open that URL on phone.
# NEXTAUTH_URL is intentionally absent: with trustHost (lib/auth.config.js) the app
# derives the callback host from the request, so localhost + tunnel URLs both work.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Session signing secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# AUTH_SECRET is the Auth.js v5 name; NEXTAUTH_SECRET is kept as a fallback.
AUTH_SECRET=""
NEXTAUTH_SECRET=""

# Leave NEXTAUTH_URL unset so the app derives the callback host per request
# (localhost, ngrok tunnel, production domain all work). Only pin it if you
# need to force one canonical host.
# NEXTAUTH_URL="http://localhost:3000"

# First admin, auto-promoted on Google sign-in (spec §8). Leave empty to disable.
ADMIN_EMAIL=""
